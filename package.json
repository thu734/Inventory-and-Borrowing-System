{
  "name": "cpe-equipment-borrowing", "private": true, "version": "0.1.0",
  "workspaces": ["backend", "frontend"],
  "engines": {"node": ">=24.14.0 <25"},
  "scripts": {
    "dev": "concurrently -k -n api,web \"npm run dev -w backend\" \"npm run dev -w frontend\"",
    "build": "npm run build --workspaces",
    "typecheck": "npm run typecheck --workspaces",
    "test": "npm run test --workspaces",
    "test:unit": "npm run test:unit -w backend",
    "test:api": "npm run test:api -w backend",
    "test:ui": "npm run test -w frontend",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate deploy",
    "db:seed": "prisma db seed",
    "test:db": "vitest run prisma/tests"
  },
  "prisma": {"seed": "tsx prisma/seed.ts"},
  "devDependencies": {
    "concurrently": "^9.2.1",
    "prisma": "^6.19.0",
    "tsx": "^4.20.6",
    "typescript": "~5.9.3",
    "vitest": "^4.0.8"
  }
}
